{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Transcriptor",
  "version": "3.2.0",
  "identifier": "com.transcriptor.desktop",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "deb", "appimage"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "category": "Productivity",
    "shortDescription": "Press a hotkey, speak, and the text lands at your cursor.",
    "longDescription": "Streaming speech-to-text through the Soniox real-time API. Dictation at the cursor, meeting and file transcription, everything kept locally.",
    "publisher": "Transcriptor",
    "copyright": "PolyForm Shield 1.0.0",
    "licenseFile": "../../LICENSE",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false
      },
      "webviewInstallMode": {
        "type": "embedBootstrapper"
      }
    },
    "linux": {
      "deb": {
        "depends": ["libasound2"],
        "recommends": ["pulseaudio-utils"]
      }
    }
  }
}
