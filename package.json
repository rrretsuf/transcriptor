{
  "name": "transcriber",
  "productName": "Transcriber",
  "version": "1.0.0",
  "description": "Instant voice dictation for macOS, powered by Soniox real-time speech-to-text.",
  "license": "MIT",
  "author": "Filip Kustec",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "npm run keytap && electron-builder --mac",
    "icons": "python3 scripts/make-icons.py",
    "test": "node --test tests/geometry.cjs tests/main.cjs tests/session.cjs && electron tests/renderer.cjs",
    "keytap": "swiftc -O -o assets/keytap scripts/keytap.swift"
  },
  "devDependencies": {
    "electron": "^44.2.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.transcriber.app",
    "productName": "Transcriber",
    "files": [
      "main.js",
      "preload.js",
      "renderer/**",
      "assets/**"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "assets/icon.icns",
      "target": [
        {
          "target": "dir",
          "arch": [
            "arm64"
          ]
        }
      ],
      "extendInfo": {
        "LSUIElement": true,
        "NSMicrophoneUsageDescription": "Transcriber needs the microphone to transcribe your speech."
      },
      "identity": "Transcriber Local Signing",
      "hardenedRuntime": false
    },
    "asarUnpack": [
      "assets/keytap"
    ]
  }
}
